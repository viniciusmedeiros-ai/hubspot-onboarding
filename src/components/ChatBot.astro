---
---

<!-- Botão flutuante -->
<button
  id="chat-toggle"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-[#ff4800] shadow-lg hover:scale-105 transition-transform duration-200"
  aria-label="Abrir assistente"
>
  <!-- Ícone chat (visível quando fechado) -->
  <svg id="icon-open" class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
  </svg>
  <!-- Ícone fechar (visível quando aberto) -->
  <svg id="icon-close" class="hidden w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
  </svg>
</button>

<!-- Janela do chat -->
<div
  id="chat-window"
  class="hidden fixed bottom-24 right-6 z-50 w-[340px] sm:w-[380px] rounded-2xl border border-[rgba(255,255,255,0.10)] bg-[#1a1a1a] shadow-2xl flex flex-col overflow-hidden"
  style="max-height: 520px;"
>
  <!-- Header -->
  <div class="flex items-center gap-3 px-4 py-3 border-b border-[rgba(255,255,255,0.08)] bg-[#141414]">
    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-[#FF7A59] to-[#E6007E] shrink-0">
      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold text-white">Assistente HubSpot</p>
      <p class="text-[10px] text-[#b3b3b3]/60">Tire dúvidas sobre as aulas</p>
    </div>
    <span class="flex items-center gap-1 text-[10px] text-[#22C55E] font-medium">
      <span class="w-1.5 h-1.5 rounded-full bg-[#22C55E] inline-block"></span>
      Online
    </span>
  </div>

  <!-- Mensagens -->
  <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-4" style="min-height: 280px; max-height: 320px;">

    <!-- Mensagem do bot -->
    <div class="flex items-start gap-2">
      <div class="shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-[#FF7A59] to-[#E6007E] flex items-center justify-center mt-0.5">
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
      </div>
      <div class="bg-[#222] rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%]">
        <p class="text-sm text-[#e0e0e0] leading-relaxed">Olá! Sou o assistente do Onboarding HubSpot. Posso responder dúvidas sobre as aulas e conteúdos do programa. Como posso ajudar?</p>
      </div>
    </div>

    <!-- Mensagem do usuário (exemplo) -->
    <div class="flex items-start gap-2 flex-row-reverse">
      <div class="shrink-0 w-7 h-7 rounded-full bg-[#2a2a2a] border border-[rgba(255,255,255,0.10)] flex items-center justify-center mt-0.5">
        <svg class="w-3.5 h-3.5 text-[#b3b3b3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
      <div class="bg-[#FF7A59]/15 border border-[rgba(255,122,89,0.20)] rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[80%]">
        <p class="text-sm text-[#e0e0e0] leading-relaxed">O que é um shared deal no HubSpot CRM?</p>
      </div>
    </div>

    <!-- Resposta do bot -->
    <div class="flex items-start gap-2">
      <div class="shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-[#FF7A59] to-[#E6007E] flex items-center justify-center mt-0.5">
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
      </div>
      <div class="bg-[#222] rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-[80%]">
        <p class="text-sm text-[#e0e0e0] leading-relaxed">Um <strong class="text-white">shared deal</strong> é um negócio criado no CRM do HubSpot em parceria com a equipe de vendas da HubSpot. Ele permite que você e o time HubSpot colaborem numa mesma oportunidade, gerando <strong class="text-white">revenue share</strong> para a sua agência quando o deal é fechado. Isso é abordado na aula <em class="text-[#FF7A59]">Como Vender com Sua Equipe HubSpot</em>.</p>
      </div>
    </div>

  </div>

  <!-- Input -->
  <div class="px-4 py-3 border-t border-[rgba(255,255,255,0.08)] bg-[#141414]">
    <div class="flex items-center gap-2 rounded-xl border border-[rgba(255,255,255,0.10)] bg-[#0d0d0d] px-3 py-2">
      <input
        id="chat-input"
        type="text"
        placeholder="Escreva sua dúvida..."
        class="flex-1 bg-transparent text-sm text-white placeholder-[#b3b3b3]/40 outline-none"
        disabled
      />
      <button
        id="chat-send"
        class="flex items-center justify-center w-7 h-7 rounded-lg bg-[#FF7A59]/20 text-[#FF7A59] hover:bg-[#FF7A59] hover:text-white transition-colors opacity-50 cursor-not-allowed"
        disabled
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
      </button>
    </div>
    <p class="text-[10px] text-[#b3b3b3]/30 text-center mt-2">Integração com IA em breve</p>
  </div>
</div>

<script>
  const toggle = document.getElementById('chat-toggle');
  const window_ = document.getElementById('chat-window');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !window_?.classList.contains('hidden');
    window_?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>
