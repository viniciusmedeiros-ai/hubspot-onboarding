---
const year = new Date().getFullYear();
---

<footer class="border-t border-[rgba(255,255,255,0.06)] bg-[#0a0a0a] py-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="text-[10px] uppercase tracking-widest text-[#b3b3b3]/40">
      © {year} Hagens × HubSpot. Material exclusivo de onboarding.
    </p>
    <p class="text-[10px] uppercase tracking-widest text-[#b3b3b3]/40">
      Uso interno — não compartilhar externamente
    </p>
  </div>
</footer>
