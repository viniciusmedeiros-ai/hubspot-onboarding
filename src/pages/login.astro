---
import '../styles/global.css';

const error = Astro.url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  dominio: 'Acesso restrito a emails @hagens.com.br.',
  acesso:  'Sessão inválida. Faça login novamente.',
  token:   'Erro ao autenticar com o Google. Tente novamente.',
  usuario: 'Não foi possível obter os dados da conta Google.',
  estado:  'Erro de segurança. Tente novamente.',
};

const errorMsg = error ? (errorMessages[error] ?? 'Erro desconhecido.') : null;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth bg-[#151515]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Login | Onboarding HubSpot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>

  <body class="min-h-screen bg-[#151515] text-white antialiased flex items-center justify-center px-4">

    <!-- Constellation background -->
    <canvas id="bg-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>

    <div class="relative z-10 w-full max-w-sm">

      <!-- Card -->
      <div class="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[#1a1a1a] p-8 shadow-2xl">

        <!-- Logos -->
        <div class="flex items-center justify-center gap-3 mb-8">
          <img src="/logo.svg" alt="Hagens" class="h-6" />
          <span class="text-[#b3b3b3]/40 font-light text-lg">×</span>
          <img src="/hubspot-logo.svg" alt="HubSpot" class="h-7" />
        </div>

        <h1 class="text-lg font-bold text-white text-center mb-1">Onboarding HubSpot Academy</h1>
        <p class="text-xs text-[#b3b3b3]/60 text-center mb-8">Acesso restrito à equipe Hagens</p>

        {errorMsg && (
          <div class="mb-6 flex items-start gap-2.5 rounded-xl border border-[rgba(230,0,0,0.25)] bg-[rgba(230,0,0,0.08)] px-4 py-3">
            <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-xs text-red-400 leading-relaxed">{errorMsg}</p>
          </div>
        )}

        <!-- Botão Google -->
        <a
          href="/auth/google"
          class="flex items-center justify-center gap-3 w-full rounded-xl border border-[rgba(255,255,255,0.12)] bg-white px-4 py-3 text-sm font-semibold text-[#1a1a1a] hover:bg-gray-50 transition-colors shadow-sm"
        >
          <!-- Google icon -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Entrar com Google
        </a>

        <p class="text-[10px] text-[#b3b3b3]/30 text-center mt-6 leading-relaxed">
          Apenas emails <span class="text-[#b3b3b3]/50">@hagens.com.br</span> têm acesso a esta plataforma.
        </p>
      </div>
    </div>

    <script>
      (function() {
        var canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
        var ctx = canvas.getContext('2d')!;
        var W: number, H: number;
        var COLORS = ['#E6007E', '#FF7A59', '#FF8C42'];
        var DOTS = 40, DIST = 130;
        var dots: Array<{x:number;y:number;vx:number;vy:number;r:number;col:string}> = [];
        function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
        function rand(a: number, b: number) { return a + Math.random() * (b - a); }
        function init() { dots = []; for (var i=0;i<DOTS;i++) dots.push({x:rand(0,W),y:rand(0,H),vx:rand(-0.2,0.2),vy:rand(-0.2,0.2),r:rand(1,2),col:COLORS[Math.floor(Math.random()*COLORS.length)]}); }
        function hex2rgb(h: string) { return parseInt(h.slice(1,3),16)+','+parseInt(h.slice(3,5),16)+','+parseInt(h.slice(5,7),16); }
        function draw() {
          ctx.clearRect(0,0,W,H);
          for (var i=0;i<dots.length;i++) {
            var a=dots[i]; a.x+=a.vx; a.y+=a.vy;
            if(a.x<-10)a.x=W+10;if(a.x>W+10)a.x=-10;if(a.y<-10)a.y=H+10;if(a.y>H+10)a.y=-10;
            for(var j=i+1;j<dots.length;j++){var b=dots[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy);if(d<DIST){ctx.strokeStyle='rgba('+hex2rgb(a.col)+','+(1-d/DIST)*0.12+')';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();}}
            ctx.fillStyle='rgba('+hex2rgb(a.col)+',0.25)';ctx.beginPath();ctx.arc(a.x,a.y,a.r,0,Math.PI*2);ctx.fill();
          }
          requestAnimationFrame(draw);
        }
        window.addEventListener('resize',function(){resize();init();}); resize();init();draw();
      })();
    </script>
  </body>
</html>
