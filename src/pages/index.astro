---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressCard from '../components/ProgressCard.astro';
import ModuloAccordion from '../components/ModuloAccordion.astro';
import { getCollection } from 'astro:content';

const todasAulas = await getCollection('aulas');
const aulasDisponiveis = todasAulas.filter(a => !a.data.emBreve);
const totalDisponiveis = aulasDisponiveis.length;
const totalAulas = todasAulas.length;

const modulos = [
  { numero: 1, id: 'selling-series',  label: 'Selling Series' },
  { numero: 2, id: 'servicing-series', label: 'Servicing Series' },
  { numero: 3, id: 'getting-started', label: 'CRM Setup' },
  { numero: 4, id: 'marketing',       label: 'Marketing Hub' },
  { numero: 5, id: 'sales',           label: 'Sales Hub' },
  { numero: 6, id: 'service',         label: 'Service Hub' },
];

function getAulasDoModulo(moduloId: string) {
  return todasAulas
    .filter(a => a.data.modulo === moduloId)
    .sort((a, b) => a.data.ordem - b.data.ordem)
    .map(a => ({
      slug: a.slug,
      title: a.data.title,
      aulaNum: a.data.aulaNum,
      duracao: a.data.duracao,
      emBreve: a.data.emBreve,
    }));
}
---

<BaseLayout title="Onboarding HubSpot" description="Plataforma de videoaulas do programa de parceria Hagens × HubSpot.">

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-[#FF7A59] opacity-[0.05] blur-3xl"></div>
    <div class="pointer-events-none absolute -top-20 right-0 h-[400px] w-[400px] rounded-full bg-[#E6007E] opacity-[0.04] blur-3xl"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 py-16 sm:py-24 flex flex-col sm:flex-row items-center gap-10 sm:gap-16">

      <!-- Texto -->
      <div class="flex-1 min-w-0">
        <h1 class="text-4xl sm:text-6xl font-bold text-white leading-tight tracking-tight">
          Onboarding<br/>
          <span class="text-[#FF7A59]">HubSpot Academy</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-[#b3b3b3] max-w-xl leading-relaxed">
          Capacitação oficial do programa de parceria Hagens × HubSpot.
        </p>

        <div class="mt-6 flex items-center gap-2">
          <div class="flex items-center gap-1.5 rounded-full border border-[rgba(255,255,255,0.10)] bg-[rgba(255,255,255,0.04)] px-3 py-1.5">
            <svg class="w-3 h-3 text-[#FF7A59]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.87v6.26a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#b3b3b3]">{totalDisponiveis} aulas</span>
          </div>
          <div class="flex items-center gap-1.5 rounded-full border border-[rgba(255,255,255,0.10)] bg-[rgba(255,255,255,0.04)] px-3 py-1.5">
            <svg class="w-3 h-3 text-[#FF7A59]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#b3b3b3]">{modulos.length} módulos</span>
          </div>
        </div>
    </div>

      <!-- Ilustração -->
      <div class="hidden sm:flex shrink-0 w-64 xl:w-72 items-center justify-center">
        <svg id="hero-illustration" viewBox="0 0 280 260" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full drop-shadow-2xl">
          <!-- Glow de fundo -->
          <ellipse cx="140" cy="130" rx="120" ry="110" fill="rgba(255,122,89,0.06)"/>
          <!-- Monitor -->
          <rect class="il-monitor" x="20" y="20" width="200" height="155" rx="12" fill="#1a1a1a" stroke="rgba(255,255,255,0.10)" stroke-width="1.5"/>
          <!-- Barra do topo -->
          <rect class="il-topbar" x="20" y="20" width="200" height="32" rx="12" fill="#222"/>
          <rect class="il-topbar" x="20" y="40" width="200" height="12" fill="#222"/>
          <!-- Dots -->
          <circle cx="40" cy="36" r="5" fill="#FF5F57"/>
          <circle cx="56" cy="36" r="5" fill="#FFBD2E"/>
          <circle cx="72" cy="36" r="5" fill="#28CA41"/>
          <!-- Barra de busca fake -->
          <rect class="il-overlay" x="90" y="28" width="110" height="16" rx="8" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
          <!-- Sidebar -->
          <rect class="il-sidebar" x="28" y="62" width="44" height="104" rx="6" fill="#141414"/>
          <!-- Itens sidebar -->
          <rect class="il-item" x="34" y="72" width="32" height="6" rx="3" fill="rgba(255,255,255,0.15)"/>
          <rect class="il-item" x="34" y="85" width="24" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <rect class="il-item" x="34" y="97" width="28" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <rect class="il-item" x="34" y="109" width="20" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <rect class="il-item" x="34" y="121" width="26" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <rect class="il-item" x="34" y="133" width="22" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <rect class="il-item" x="34" y="145" width="30" height="5" rx="2.5" fill="rgba(255,255,255,0.08)"/>
          <!-- Conteúdo principal -->
          <rect class="il-content" x="82" y="62" width="130" height="104" rx="6" fill="#111"/>
          <!-- Cards no conteúdo -->
          <rect x="90" y="70" width="35" height="28" rx="5" fill="rgba(255,122,89,0.20)" stroke="rgba(255,122,89,0.30)" stroke-width="1"/>
          <rect x="131" y="70" width="35" height="28" rx="5" fill="rgba(230,0,126,0.15)" stroke="rgba(230,0,126,0.25)" stroke-width="1"/>
          <rect x="172" y="70" width="32" height="28" rx="5" fill="rgba(245,166,35,0.15)" stroke="rgba(245,166,35,0.25)" stroke-width="1"/>
          <!-- Ícones nos cards -->
          <rect x="99" y="79" width="16" height="3" rx="1.5" fill="#FF7A59"/>
          <rect x="99" y="86" width="10" height="3" rx="1.5" fill="rgba(255,122,89,0.5)"/>
          <rect x="140" y="79" width="16" height="3" rx="1.5" fill="#E6007E"/>
          <rect x="140" y="86" width="10" height="3" rx="1.5" fill="rgba(230,0,126,0.5)"/>
          <rect x="180" y="79" width="14" height="3" rx="1.5" fill="#F5A623"/>
          <rect x="180" y="86" width="9" height="3" rx="1.5" fill="rgba(245,166,35,0.5)"/>
          <!-- Barra de progresso -->
          <rect class="il-item" x="90" y="108" width="114" height="6" rx="3" fill="rgba(255,255,255,0.06)"/>
          <rect x="90" y="108" width="68" height="6" rx="3" fill="url(#prog)"/>
          <!-- Label progresso -->
          <rect class="il-item" x="90" y="120" width="40" height="4" rx="2" fill="rgba(255,255,255,0.10)"/>
          <rect x="136" y="120" width="24" height="4" rx="2" fill="rgba(255,122,89,0.3)"/>
          <!-- Lista de itens -->
          <rect class="il-item" x="90" y="132" width="114" height="4" rx="2" fill="rgba(255,255,255,0.07)"/>
          <rect class="il-item" x="90" y="142" width="90" height="4" rx="2" fill="rgba(255,255,255,0.05)"/>
          <rect class="il-item" x="90" y="152" width="100" height="4" rx="2" fill="rgba(255,255,255,0.05)"/>
          <!-- Check dots -->
          <circle cx="86" cy="134" r="3" fill="#22C55E" opacity="0.7"/>
          <circle class="il-item" cx="86" cy="144" r="3" fill="rgba(255,255,255,0.15)"/>
          <circle class="il-item" cx="86" cy="154" r="3" fill="rgba(255,255,255,0.15)"/>
          <!-- Base do monitor -->
          <rect class="il-base" x="105" y="175" width="30" height="14" rx="3" fill="#1a1a1a" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
          <rect class="il-base" x="90" y="188" width="60" height="6" rx="3" fill="#1a1a1a" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
          <!-- Cursor -->
          <polygon class="il-cursor" points="210,145 222,167 215,164 211,173 207,163 200,166" fill="white" opacity="0.8"/>
          <!-- Gradiente progresso -->
          <defs>
            <linearGradient id="prog" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#F5A623"/>
              <stop offset="100%" stop-color="#FF7A59"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

    </div>
  </section>

  <!-- Conteúdo -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 space-y-5">

    <!-- Progresso -->
    <ProgressCard totalAulas={totalDisponiveis} />

    <!-- Divisor -->
    <div class="flex items-center gap-3 py-2">
      <span class="h-px flex-1 bg-[rgba(255,255,255,0.06)]"></span>
      <span class="text-[10px] font-bold uppercase tracking-widest text-[#b3b3b3]/50">Módulos do curso</span>
      <span class="h-px flex-1 bg-[rgba(255,255,255,0.06)]"></span>
    </div>

    <!-- Módulos -->
    {modulos.map((mod, idx) => (
      <ModuloAccordion
        numero={mod.numero}
        label={mod.label}
        aulas={getAulasDoModulo(mod.id)}
        defaultOpen={false}
      />
    ))}

  </div>

</BaseLayout>
