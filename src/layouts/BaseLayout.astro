---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatBot from '../components/ChatBot.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Onboarding HubSpot — Hagens × HubSpot Academy',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth bg-[#151515]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151515" />
    <title>{title} | Onboarding HubSpot</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Outfit font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Aplica tema antes do render para evitar flash -->
    <script is:inline>
      if (localStorage.getItem('hubspot-theme') === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>

  <body class="min-h-screen bg-[#151515] text-white antialiased">
    <!-- Constellation background -->
    <canvas id="bg-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>

    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <ChatBot />

    <script>
      (function() {
        var canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
        var ctx    = canvas.getContext('2d')!;
        var W: number, H: number;
        var COLORS = ['#E6007E', '#FF7A59', '#FF8C42', '#f509dd', '#FF6B35'];
        var DOTS   = 60;
        var DIST   = 130;
        var dots: Array<{x:number;y:number;vx:number;vy:number;r:number;col:string}> = [];

        function resize() {
          W = canvas.width  = window.innerWidth;
          H = canvas.height = window.innerHeight;
        }

        function rand(min: number, max: number) { return min + Math.random() * (max - min); }

        function init() {
          dots = [];
          for (var i = 0; i < DOTS; i++) {
            var col = COLORS[Math.floor(Math.random() * COLORS.length)];
            dots.push({ x: rand(0, W), y: rand(0, H), vx: rand(-0.3, 0.3), vy: rand(-0.3, 0.3), r: rand(1.2, 2.5), col });
          }
        }

        function hex2rgb(hex: string) {
          var r = parseInt(hex.slice(1,3),16);
          var g = parseInt(hex.slice(3,5),16);
          var b = parseInt(hex.slice(5,7),16);
          return r+','+g+','+b;
        }

        function isLight() { return document.documentElement.classList.contains('light'); }

        function draw() {
          var light = isLight();
          var dotAlpha  = light ? 0.80 : 0.30;
          var lineAlpha = light ? 0.40 : 0.10;
          var glowAlpha = light ? 0.35 : 0.15;
          ctx.clearRect(0, 0, W, H);
          for (var i = 0; i < dots.length; i++) {
            var a = dots[i];
            a.x += a.vx; a.y += a.vy;
            if (a.x < -10) a.x = W + 10;
            if (a.x > W + 10) a.x = -10;
            if (a.y < -10) a.y = H + 10;
            if (a.y > H + 10) a.y = -10;
            for (var j = i + 1; j < dots.length; j++) {
              var b = dots[j];
              var dx = a.x - b.x, dy = a.y - b.y;
              var d = Math.sqrt(dx*dx + dy*dy);
              if (d < DIST) {
                ctx.strokeStyle = 'rgba(' + hex2rgb(a.col) + ',' + (1 - d/DIST) * lineAlpha + ')';
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
              }
            }
            var grd = ctx.createRadialGradient(a.x, a.y, 0, a.x, a.y, a.r * 3);
            grd.addColorStop(0, 'rgba(' + hex2rgb(a.col) + ',' + glowAlpha + ')');
            grd.addColorStop(1, 'rgba(' + hex2rgb(a.col) + ',0)');
            ctx.fillStyle = grd;
            ctx.beginPath(); ctx.arc(a.x, a.y, a.r * 3, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = 'rgba(' + hex2rgb(a.col) + ',' + dotAlpha + ')';
            ctx.beginPath(); ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2); ctx.fill();
          }
          requestAnimationFrame(draw);
        }

        window.addEventListener('resize', function() { resize(); init(); });
        resize(); init(); draw();
      })();
    </script>
  </body>
</html>
